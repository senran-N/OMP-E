#include <winresrc.h>

IDI_APPICON ICON "../assets/icons/omp_desktop.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,1,0
 PRODUCTVERSION 0,1,1,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "senran-N"
            VALUE "FileDescription", "OMP Desktop - Native GPU Client for oh-my-pi"
            VALUE "FileVersion", "0.1.1.0"
            VALUE "InternalName", "omp_desktop"
            VALUE "LegalCopyright", "Copyright (c) 2026 senran-N. MIT License."
            VALUE "OriginalFilename", "omp_desktop.exe"
            VALUE "ProductName", "OMP Desktop"
            VALUE "ProductVersion", "0.1.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
